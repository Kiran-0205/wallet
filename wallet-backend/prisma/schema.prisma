generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      String   @id @default(uuid())
  email   String   @unique
  account Account?
}

model Account {
  id           String @id @default(uuid())
  userId       String @unique
  balanceCents Int    @default(0)

  user User @relation(fields: [userId], references: [id])
}